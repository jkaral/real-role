{
  "name": "@real-role/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Real Role Chrome extension (MV3): badge, side panel, save & track (owner: Claude Code)",
  "type": "module",
  "dependencies": {
    "@real-role/parsers": "workspace:*",
    "@real-role/scoring": "workspace:*",
    "@real-role/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "wxt": "^0.21.4"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:demo": "cross-env WXT_DEMO=1 WXT_API_BASE=http://localhost:3100 wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "pnpm build:demo && playwright test"
  }
}
