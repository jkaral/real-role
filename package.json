{
  "name": "real-role",
  "private": true,
  "description": "Real Role: a Freshness Score for job postings.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm format:check && pnpm check:agents && turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:agents": "node scripts/check-agent-docs.mjs",
    "demo:video": "pnpm --filter @real-role/demo demo:video"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.34.7"
}
