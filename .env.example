# Copy to apps/web/.env.local and fill in. Never commit real values.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth.js (GitHub sign-in) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Scoring: LLM rubric (optional; heuristics-only fallback when empty) ---
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5 (cheapest current model, per brief A3).
RUBRIC_MODEL=

# --- Extension ---
# Comma-separated chrome-extension:// origins allowed to call the API (CORS)
EXTENSION_ORIGINS=

# --- Demo seeding (never set on production) ---
# db:seed-demo refuses to run unless ALLOW_DEMO_SEED=1, and refuses DATABASE_URLs containing
# PRODUCTION_DATABASE_HOST (e.g. the Neon endpoint id of the production branch).
ALLOW_DEMO_SEED=
PRODUCTION_DATABASE_HOST=

# --- Demo narration (optional; falls back to free local TTS) ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
