# Copy to .env.local (apps/web) and fill in. Never commit real values.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth.js (GitHub sign-in) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Public base URL of the web app (e.g. http://localhost:3000 or the Vercel URL)
AUTH_URL=http://localhost:3000

# --- Scoring: LLM rubric (optional; heuristics-only fallback when empty) ---
ANTHROPIC_API_KEY=

# --- Extension ---
# Comma-separated chrome-extension:// origins allowed to call the API (CORS)
EXTENSION_ORIGINS=

# --- Demo narration (optional; falls back to free local TTS) ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
